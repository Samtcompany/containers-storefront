# The Aamer API this storefront reads its published configuration from (server-side only).
AAMER_API_URL=http://127.0.0.1:3001
# The storefront's public name in Aamer (the slug the store builder shows under النشر).
STOREFRONT_SLUG=containers
# The origin this site is served from — sent to Aamer as the request origin on the public writes.
SITE_ORIGIN=http://127.0.0.1:3100
